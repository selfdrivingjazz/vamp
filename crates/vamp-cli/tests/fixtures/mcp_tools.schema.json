  {
    "name": "vamp_explore_link",
    "description": "Get the existing Vampire app/deeplink and optional server link for an exploration or one of its items.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "server_url": {
          "type": "string",
          "description": "Optional http(s) authority URL; otherwise use the context's configured URL.",
          "maxLength": 65536
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vamp_explore_changes",
    "description": "Read other actors' changes since a cursor or this actor's last read. peek=true leaves the cursor unchanged. Read-only servers always peek and reject peek=false.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "since": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "peek": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vamp_add",
    "description": "Import one local file or downloaded http(s) media URL (exactly one), at most 64 MiB. The engine attributes added_by to this MCP actor. Bytes are imported into the library; a URL is media, not a web page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "description": "Path to a local regular file, resolved on the MCP host.",
          "maxLength": 65536
        },
        "url": {
          "type": "string",
          "description": "Direct http(s) media URL.",
          "maxLength": 65536
        },
        "description": {
          "type": "string",
          "description": "Human description.",
          "maxLength": 65536
        },
        "tags": {
          "type": "array",
          "description": "Initial user tags.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "source_url": {
          "type": "string",
          "description": "Source page URL; defaults to the downloaded media URL.",
          "maxLength": 65536
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vamp_tag",
    "description": "Add/remove user tags, or explicitly replace all tags. Uses the core MetadataPatch rules (replace, then add, then remove).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "tags": {
          "type": "array",
          "description": "Replace all user tags, including [] to clear.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "add_tags": {
          "type": "array",
          "description": "Tags to add.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "remove_tags": {
          "type": "array",
          "description": "Tags to remove.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional optimistic concurrency guard from inspect."
        }
      },
      "required": [
        "asset_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
