  {
    "name": "vamp_explore_add",
    "description": "Add a finding with provenance, idempotently using existing core exploration logic. Supply a direct image_url, a local file, or neither for a rendered note/link card. At most 64 MiB of imported media. URL is the source page, not the downloaded image.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "note": {
          "type": "string",
          "description": "Why the finding matters.",
          "maxLength": 65536
        },
        "tags": {
          "type": "array",
          "description": "User tags.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "url": {
          "type": "string",
          "description": "Source page http(s) URL.",
          "maxLength": 65536
        },
        "folder": {
          "type": "string",
          "description": "Subfolder path within the exploration, e.g. studios/posters.",
          "maxLength": 65536
        },
        "image_url": {
          "type": "string",
          "description": "Direct http(s) media URL; mutually exclusive with file.",
          "maxLength": 65536
        },
        "file": {
          "type": "string",
          "description": "Local regular file on the MCP host; mutually exclusive with image_url.",
          "maxLength": 65536
        },
        "kind": {
          "type": "string",
          "description": "Card label when no file/image_url is supplied; defaults to link or note.",
          "maxLength": 65536
        }
      },
      "required": [
        "slug",
        "name"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vamp_explore_summary",
