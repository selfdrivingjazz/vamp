  {
    "name": "vamp_fetch_image",
    "description": "Return MCP image content, defaulting to the thumbnail; preview is opt-in and original requires explicit tier=original. Never falls back to the original. Only PNG, JPEG, GIF and WebP are accepted. Encoded image bytes are capped before reading/encoding; originals are rejected before fetching when catalog size exceeds the cap.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "tier": {
          "type": "string",
          "enum": [
            "thumbnail",
            "preview",
            "original"
          ],
          "default": "thumbnail"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608,
          "default": 4194304
        }
      },
      "required": [
        "asset_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vamp_explore_show",
    "description": "Show an exploration's brief, findings summary, folders, items and app link.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
