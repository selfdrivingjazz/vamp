[
  {
    "name": "vamp_search",
    "description": "Search library metadata, or use semantic/hybrid ranking when a text embedder and image embeddings are available. Semantic errors are returned, not hidden by a metadata fallback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "type": "string",
          "enum": [
            "metadata",
            "semantic",
            "hybrid"
          ],
          "default": "metadata"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "added_by": {
          "type": "string",
          "description": "Filter to owner, agents, or actor:<exact actor>.",
          "maxLength": 65536
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "vamp_browse",
    "description": "Browse items with an optional query restricted to folders, a smart folder, tags, and other core browse filters. Semantic ranking uses the same scope when configured; metadata search is the default.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 4096
        },
        "collection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "folder_ids": {
          "type": "array",
          "description": "Folder IDs to include.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "include_subfolders": {
          "type": "boolean",
          "description": "Include descendants of selected folders."
        },
        "smart_folder_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "tags": {
          "type": "array",
          "description": "Require every tag.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "tags_any": {
          "type": "array",
          "description": "Require at least one tag.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "untagged": {
          "type": "boolean",
          "description": "Only untagged items."
        },
        "uncategorized": {
          "type": "boolean",
          "description": "Only items without a folder."
        },
        "kind": {
          "type": "string",
          "description": "MIME top-level type, such as image or video.",
          "maxLength": 65536
        },
        "exts": {
          "type": "array",
          "description": "File extensions.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "shape": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait",
            "square",
            "panorama"
          ]
        },
        "rating_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "colors": {
          "type": "array",
          "description": "Hex colors, such as #ff8800.",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "color_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "sort": {
          "type": "string",
          "enum": [
            "added_desc",
            "added_asc",
            "name_asc",
            "name_desc",
            "rating_desc",
            "size_desc",
            "dimensions_desc",
            "modified_desc",
            "created_desc",
            "last_viewed_desc",
            "random",
            "color"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "date_from": {
          "type": "string",
          "description": "Inclusive date or RFC 3339 timestamp.",
          "maxLength": 65536
        },
        "date_to": {
          "type": "string",
          "description": "Inclusive date or RFC 3339 timestamp.",
          "maxLength": 65536
        },
        "date_field": {
          "type": "string",
          "enum": [
            "imported",
            "created",
            "modified"
          ]
        },
        "size_min": {
          "type": "integer",
          "minimum": 0
        },
        "size_max": {
          "type": "integer",
          "minimum": 0
        },
        "recently_used": {
          "type": "boolean",
          "description": "Only previously viewed items."
        },
        "trash": {
          "type": "boolean",
          "description": "Browse trash instead of live items."
        },
        "semantic": {
          "type": "boolean",
          "description": "Rank the scoped query semantically when an embedder is configured."
        },
        "added_by": {
          "type": "string",
          "description": "Filter to owner, agents, or actor:<exact actor>.",
          "maxLength": 65536
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
