  {
    "name": "vamp_explore_ensure",
    "description": "Idempotently create/find an exploration under Explorations/. A supplied brief replaces its brief while preserving its findings summary.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Display title used when creating the exploration.",
          "maxLength": 65536
        },
        "brief": {
          "type": "string",
          "description": "Exploration brief.",
          "maxLength": 65536
        }
      },
      "required": [
        "slug"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
